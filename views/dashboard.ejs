<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'SkillIntel Dashboard' %></title>

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #0f172a;
            color: #e2e8f0;
            min-height: 100vh;
        }
        .header {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border-bottom: 1px solid #334155;
            padding: 1.5rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .header h1 {
            font-size: 1.5rem;
            background: linear-gradient(135deg, #38bdf8, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .header-user {
            display: flex;
            align-items: center;
            gap: 1rem;
            font-size: 0.9rem;
            color: #94a3b8;
        }
        .header-user .name {
            color: #38bdf8;
            font-weight: 600;
        }
        .logout-btn {
            background: #ef4444;
            color: white;
            border: none;
            padding: 0.4rem 1rem;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.85rem;
        }
        .logout-btn:hover { background: #dc2626; }
        .stats-bar {
            display: flex;
            gap: 1.5rem;
            padding: 1.5rem 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }
        .stat-card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 12px;
            padding: 1.2rem;
            flex: 1;
            text-align: center;
        }
        .stat-card .number {
            font-size: 2rem;
            font-weight: 700;
            color: #38bdf8;
        }
        .stat-card .label {
            font-size: 0.8rem;
            color: #94a3b8;
            margin-top: 0.3rem;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem 3rem;
        }
        .update-info {
            font-size: 0.8rem;
            color: #64748b;
            margin-bottom: 1rem;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: #1e293b;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #334155;
        }
        th, td { padding: 1rem 1.2rem; text-align: left; }
        th {
            background: #0f172a;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #94a3b8;
            border-bottom: 2px solid #334155;
        }
        td { border-bottom: 1px solid #1e293b; font-size: 0.9rem; }
        tr:hover td { background: #1e293b80; }
        .skill-name {
            font-weight: 600;
            color: #f1f5f9;
        }
        .demand-bar {
            width: 100px;
            height: 6px;
            background: #334155;
            border-radius: 3px;
            overflow: hidden;
            display: inline-block;
            vertical-align: middle;
            margin-right: 8px;
        }
        .demand-fill {
            height: 100%;
            border-radius: 3px;
            background: linear-gradient(90deg, #38bdf8, #818cf8);
        }
        .growth-positive { color: #4ade80; }
        .growth-negative { color: #f87171; }
        .category-badge {
            background: #334155;
            padding: 0.25rem 0.6rem;
            border-radius: 20px;
            font-size: 0.75rem;
            color: #94a3b8;
        }
        .footer {
            text-align: center;
            padding: 2rem;
            font-size: 0.8rem;
            color: #475569;
            border-top: 1px solid #1e293b;
        }
    </style>
</head>
<body>

    <div class="header">
        <h1>⚡ <%= title || 'SkillIntel' %></h1>
        <div class="header-user">
            <% if (user) { %>
                <span>Signed in as <span class="name"><%= user.name || 'User' %></span></span>
                <form action="/api/auth/logout" method="POST">
                    <button type="submit" class="logout-btn">Logout</button>
                </form>
            <% } else { %>
                <span>Not logged in</span>
            <% } %>
        </div>
    </div>

    <div class="stats-bar">
        <div class="stat-card">
            <div class="number"><%= (skills || []).length %></div>
            <div class="label">Total Skills</div>
        </div>
        <div class="stat-card">
            <div class="number">
                <%= (skills || []).filter(s => (s.growth || 0) > 20).length %>
            </div>
            <div class="label">High Growth</div>
        </div>
        <div class="stat-card">
            <div class="number">
                <%= [...new Set((skills || []).map(s => s.category || 'Other'))].length %>
            </div>
            <div class="label">Categories</div>
        </div>
    </div>

    <div class="container">
        <div class="update-info">
            📅 Last Updated: <%= lastUpdated || new Date().toLocaleString() %>
        </div>

        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Skill</th>
                    <th>Demand</th>
                    <th>Salary</th>
                    <th>Growth</th>
                    <th>Category</th>
                </tr>
            </thead>
            <tbody>
                <% (skills || []).forEach((skill, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td class="skill-name">
                            <%= skill.icon || '🔧' %> <%= skill.name || 'Unknown' %>
                        </td>
                        <td>
                            <div class="demand-bar">
                                <div class="demand-fill" style="width: <%= ((skill.demandIndex || 0) / 10) * 100 %>%"></div>
                            </div>
                            <%= skill.demandIndex || 0 %>/10
                        </td>
                        <td>
                            ₹<%= skill.salary ? Number(skill.salary).toLocaleString('en-IN') : 'N/A' %>
                        </td>
                        <td>
                            <span class="<%= (skill.growth || 0) >= 0 ? 'growth-positive' : 'growth-negative' %>">
                                <%= (skill.growth || 0) >= 0 ? '+' : '' %><%= skill.growth || 0 %>%
                            </span>
                        </td>
                        <td>
                            <span class="category-badge"><%= skill.category || 'Other' %></span>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <div class="footer">
        © 2025 SkillIntel | SSR with EJS
    </div>

</body>
</html>